<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="BiliCopilot.UI.SponsorBlock.Controls.SponsorResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  空降助手局部资源：只使用系统主题画刷，不修改全局资源。  -->
    <CornerRadius x:Key="SponsorCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="SponsorOverlayCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="SponsorRailCornerRadius">2</CornerRadius>
    <Thickness x:Key="SponsorCardPadding">12,10,12,10</Thickness>

    <Style x:Key="SponsorCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SponsorCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource SponsorCardPadding}" />
    </Style>

    <Style x:Key="SponsorSubtleCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SponsorCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource SponsorCardPadding}" />
    </Style>

    <Style x:Key="SponsorOverlayStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SponsorOverlayCornerRadius}" />
        <Setter Property="Padding" Value="12,10,10,10" />
    </Style>

    <Style x:Key="SponsorChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1,6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SponsorChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="SponsorTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="SponsorCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="SponsorSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,8,0,2" />
    </Style>

    <Style x:Key="SponsorRailStyle" TargetType="Border">
        <Setter Property="Width" Value="4" />
        <Setter Property="CornerRadius" Value="{StaticResource SponsorRailCornerRadius}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="SponsorCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,4,10,5" />
    </Style>

    <Style x:Key="SponsorCompactAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,4,10,5" />
    </Style>

    <Style x:Key="SponsorIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>
</ResourceDictionary>
