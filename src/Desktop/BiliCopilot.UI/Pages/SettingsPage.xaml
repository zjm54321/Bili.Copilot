<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageBase
    x:Class="BiliCopilot.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:BiliCopilot.UI.Controls.Settings"
    xmlns:sponsor="using:BiliCopilot.UI.SponsorBlock.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock
            Margin="16,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{ext:Locale Name=Settings}" />

        <Border
            Grid.Row="1"
            Height="1"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <ScrollViewer
            Grid.Row="2"
            Padding="16,0"
            Style="{StaticResource PageScrollViewerStyle}">
            <StackPanel Margin="0,12" Spacing="4">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>
                <TextBlock
                    Margin="0,8,0,4"
                    HorizontalAlignment="Left"
                    Text="播放器设置" />
                <settings:PlayerControlSettingControl />
                <settings:PlayerBehaviorSettingControl />
                <settings:MpvExtraSettingControl />
                <settings:ScreenshotSettingControl />
                <!--
                    空降助手设置分组：只在宿主通过 BindSponsorSettings 提供已绑定的视图模型后显示，
                    未接入时整体折叠，不留空白占位，也不在此创建第二个协调器.
                -->
                <TextBlock
                    x:Name="SponsorGroupHeader"
                    Margin="0,16,0,8"
                    HorizontalAlignment="Left"
                    Text="空降助手"
                    Visibility="Collapsed" />
                <sponsor:SponsorSettingsSection x:Name="SponsorSettings" Visibility="Collapsed" />
                <TextBlock
                    Margin="0,16,0,8"
                    HorizontalAlignment="Left"
                    Text="{ext:Locale Name=Generic}" />
                <settings:ThemeSettingControl />
                <settings:LayoutSettingSection />
                <settings:CacheSettingControl />
                <settings:NavigationSettingControl />
                <settings:SearchRecommendSettingSection />
                <!--<settings:CloseBehaviorSettingControl />-->
                <settings:NotificationSettingControl />
                <settings:LoggerSettingControl />
                <TextBlock
                    Margin="0,16,0,8"
                    HorizontalAlignment="Left"
                    Text="{ext:Locale Name=AboutThisApp}" />
                <settings:AboutSettingControl Margin="0,0,0,16" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:SettingsPageBase>
