<?xml version="1.0" encoding="utf-8" ?>
<local:ArticleReaderPageBase
    x:Class="BiliCopilot.UI.Pages.Overlay.ArticleReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:article="using:BiliCopilot.UI.Controls.Article"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:comment="using:BiliCopilot.UI.Controls.Comment"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Pages.Overlay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <article:ArticleReader
            x:Name="Reader"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <!--  正文加载失败、为空或无法显示时的提示. 评论与左侧工具栏仍可使用.  -->
        <base:EmptyHolder
            MaxWidth="420"
            Margin="96,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Description="{x:Bind ViewModel.ErrorDescription, Mode=OneWay}"
            Emoji="&#x1F4C4;"
            Title="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
            <base:EmptyHolder.ActionElement>
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        MinWidth="96"
                        Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}"
                        Content="{ext:Locale Name=Retry}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        MinWidth="96"
                        Command="{x:Bind ViewModel.OpenInBrowserCommand, Mode=OneWay}"
                        Content="{ext:Locale Name=OpenInBrowser}"
                        Visibility="{x:Bind ViewModel.CanOpenInBrowser, Mode=OneWay}" />
                </StackPanel>
            </base:EmptyHolder.ActionElement>
        </base:EmptyHolder>

        <article:ArticleReaderToolBar
            Margin="12"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
        <base:LoadingWidget
            x:Name="LoadingView"
            Text="{ext:Locale Name=LoadingAndWait}"
            Visibility="Collapsed" />
        <comment:CommentOverlayPanel IsPanelOpened="{x:Bind ViewModel.IsCommentsOpened, Mode=TwoWay}" ViewModel="{x:Bind ViewModel.CommentModule, Mode=OneWay}" />
    </Grid>
</local:ArticleReaderPageBase>
