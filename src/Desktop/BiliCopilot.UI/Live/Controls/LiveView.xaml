<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Live.Controls.LiveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:live="using:BiliCopilot.UI.Live"
    xmlns:media="using:Richasy.BiliKernel.Models.Media"
    IsTabStop="False">

    <!--
        Visual contract: the embedded VOD player.
        - Page header       = EmbeddedPlayerView HeaderRow (56, CardBackgroundFillColorDefaultBrush, divider row).
        - Transport         = normal: IslandTransportControls card (bottom, Margin 12, MaxWidth 800, OverlayCornerRadius,
                              TransportBackground, CardStrokeColorDefaultBrush, Padding 12,8, CircleIconButtonStyle, 14px glyphs,
                              8px between commands, Placement=Top flyouts, fade);
                              full screen / compact: OverlayTransportControls bar (edge to edge, 160/120 black gradient,
                              Padding 16,0,8,0, 52px primary play, 40px player icon buttons, fade + 80px slide).
        - Danmaku box       = IslandDanmakuBox ("弹" 36px round toggle + input in the middle column).
        - Quality           = IslandFormatButton (Hd glyph, caption + 220px ItemsView, 40px card rows).
        - Side panel toggle = SideSplitButton (36px transparent, filled 14px PanelRight glyph) at the header's right edge.
        Airspace: the native video child covers VideoHost only. The transport lives in the video island above it
        in every presentation mode (the VOD PlayerOverlay model): no reserved bottom row, no cross-root moves.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!--  LiveState* keys are read by code-behind (LocalBrush): Fluent status palette, per theme.  -->
                <!--  LiveTransportBackground = IslandTransportControls "TransportBackground" (same values per theme).  -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="LiveStateLiveBrush" Color="{ThemeResource SystemFillColorSuccess}" />
                    <SolidColorBrush x:Key="LiveStateWarnBrush" Color="{ThemeResource SystemFillColorCaution}" />
                    <SolidColorBrush x:Key="LiveStateErrorBrush" Color="{ThemeResource SystemFillColorCritical}" />
                    <SolidColorBrush x:Key="LiveStateIdleBrush" Color="{ThemeResource SystemFillColorNeutral}" />
                    <SolidColorBrush
                        x:Key="LiveTransportBackground"
                        Opacity="0.67"
                        Color="Black" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LiveStateLiveBrush" Color="{ThemeResource SystemFillColorSuccess}" />
                    <SolidColorBrush x:Key="LiveStateWarnBrush" Color="{ThemeResource SystemFillColorCaution}" />
                    <SolidColorBrush x:Key="LiveStateErrorBrush" Color="{ThemeResource SystemFillColorCritical}" />
                    <SolidColorBrush x:Key="LiveStateIdleBrush" Color="{ThemeResource SystemFillColorNeutral}" />
                    <SolidColorBrush
                        x:Key="LiveTransportBackground"
                        Opacity="0.78"
                        Color="White" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="LiveStateLiveBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="LiveStateWarnBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LiveStateErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LiveStateIdleBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="LiveTransportBackground" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  Player stage stays black in every theme (same as the VOD video area).  -->
            <SolidColorBrush x:Key="LiveVideoBackdropBrush" Color="Black" />

            <!--  Normal mode: IslandTransportControls card (bottom, Margin 12, MaxWidth 800, 1px card stroke, OverlayCornerRadius).  -->
            <Style x:Key="LiveIslandTransportCardStyle" TargetType="Grid">
                <Setter Property="MaxWidth" Value="800" />
                <Setter Property="Margin" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Background" Value="{ThemeResource LiveTransportBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            </Style>

            <!--  Full screen / compact: OverlayTransportControls root (edge to edge, no stroke/corners, #00→#FF black gradient).  -->
            <Style x:Key="LiveOverlayTransportCardStyle" TargetType="Grid">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Offset="0.0" Color="#00000000" />
                            <GradientStop Offset="1" Color="#FF000000" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  Island commands: CircleIconButtonStyle; play/pause adds ButtonBackground (IslandTransportControls PlayPauseButton).  -->
            <Style
                x:Key="LiveIslandPlayButtonStyle"
                BasedOn="{StaticResource CircleIconButtonStyle}"
                TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
            </Style>
            <Style
                x:Key="LiveIslandIconButtonStyle"
                BasedOn="{StaticResource CircleIconButtonStyle}"
                TargetType="Button" />
            <!--  IslandDanmakuBox "弹" toggle: 36px round.  -->
            <Style
                x:Key="LiveIslandDanmakuToggleStyle"
                BasedOn="{StaticResource DefaultToggleButtonStyle}"
                TargetType="ToggleButton">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="18" />
            </Style>

            <!--  Overlay commands: OverlayTransportControls styles (40px BasicPlayerIcon / 52px PrimaryPlayer / TogglePlayerIcon).  -->
            <Style
                x:Key="LiveOverlayPlayButtonStyle"
                BasedOn="{StaticResource PrimaryPlayerButtonStyle}"
                TargetType="Button" />
            <Style
                x:Key="LiveOverlayIconButtonStyle"
                BasedOn="{StaticResource BasicPlayerIconButtonStyle}"
                TargetType="Button" />
            <Style
                x:Key="LiveOverlayDanmakuToggleStyle"
                BasedOn="{StaticResource TogglePlayerIconButtonStyle}"
                TargetType="ToggleButton" />

            <!--
                The VOD controls each declare this presenter style locally (IslandTransportControls / IslandFormatButton /
                IslandDanmakuBox: "TransportButtonFlyoutPresenterStyle", Padding 12,10). It is not an app-level resource,
                so it cannot be referenced from here; same key and value for parity.
            -->
            <Style
                x:Key="TransportButtonFlyoutPresenterStyle"
                BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                TargetType="FlyoutPresenter">
                <Setter Property="Padding" Value="12,10" />
            </Style>

            <Style
                x:Key="LiveMessageItemStyle"
                BasedOn="{StaticResource DefaultListViewItemStyle}"
                TargetType="ListViewItem">
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!--  Secondary caption; code-behind may set a status Foreground and later ClearValue back to this.  -->
            <Style
                x:Key="LiveFeedbackTextStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition x:Name="ChatColumn" Width="340" />
        </Grid.ColumnDefinitions>

        <!--  ============ Page header (EmbeddedPlayerView PlayerHeader: 56 / Padding 16,0 / card fill) ============  -->
        <Grid
            x:Name="PageHeader"
            Grid.Row="0"
            Grid.Column="0"
            Padding="16,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Anchor avatar opens the in-app user space (app AvatarButtonStyle: scale feedback on hover/press).  -->
            <Button
                x:Name="AnchorButton"
                Width="32"
                Height="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="OnAnchorClick"
                CornerRadius="16"
                IsEnabled="False"
                Style="{StaticResource AvatarButtonStyle}">
                <PersonPicture
                    x:Name="AnchorPicture"
                    Width="32"
                    Height="32"
                    AutomationProperties.AccessibilityView="Raw"
                    IsTabStop="False" />
            </Button>

            <!--  Title: same type as the VOD main header title (Bold, single line, trimmed).  -->
            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontWeight="Bold"
                MaxLines="1"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />

            <!--  Anchor meta (secondary caption, like the VOD header's right-hand info). Parts collapse while unknown.  -->
            <StackPanel
                x:Name="AnchorMetaRow"
                Grid.Column="2"
                MaxWidth="320"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="AnchorNameText"
                    MaxWidth="140"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <Border
                    x:Name="FollowTag"
                    Padding="6,0,6,1"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="FollowText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
                <StackPanel
                    x:Name="AudiencePanel"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="Collapsed">
                    <ic:SymbolIcon
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Symbol="People" />
                    <TextBlock
                        x:Name="AudienceText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="3"
                MaxWidth="200"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Ellipse
                    x:Name="PlaybackDot"
                    Width="8"
                    Height="8"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw" />
                <TextBlock
                    x:Name="PlaybackStatusText"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>

            <!--  Side panel toggle: SideSplitButton visuals (36, transparent, filled 14px glyph, Margin 4,0,0,0).  -->
            <Button
                x:Name="ChatToggle"
                Grid.Column="4"
                Width="36"
                Height="36"
                Margin="4,0,0,0"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="OnChatToggleClick">
                <ic:SymbolIcon
                    x:Name="ChatToggleIcon"
                    FontSize="14"
                    IconVariant="Filled"
                    Symbol="PanelRightContract" />
            </Button>
        </Grid>

        <!--  Header divider (EmbeddedPlayerView HeaderDivider), spans both columns.  -->
        <Border
            x:Name="HeaderDivider"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Height="1"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!--  ============ Player stage: the picture fills it; nothing is reserved below the video ============  -->
        <Grid
            x:Name="StageGrid"
            Grid.Row="2"
            Grid.Column="0"
            Background="{StaticResource LiveVideoBackdropBrush}">
            <!--  Host-provided layout anchor. No transforms, opacity changes, rounded clips or controls on top: native video airspace.  -->
            <Border x:Name="VideoHost" Background="{StaticResource LiveVideoBackdropBrush}" />
        </Grid>

        <!--
            Transport (one instance). Declared here only so its names and handlers are generated with this view: the
            constructor removes it before the first layout and LiveWindow places it once in the video island's overlay
            layer, where it stays for every presentation mode. Code-behind only switches styles/layout:
            - Normal                = VOD IslandTransportControls card (LiveIslandTransportCardStyle, CircleIconButtonStyle).
            - Full screen / compact = VOD OverlayTransportControls bar (LiveOverlayTransportCardStyle: edge-to-edge,
                                      160/120 tall black bottom gradient, BasicPlayerIconButtonStyle, primary 52px play).
            Command order is identical in every mode: play · refresh | danmaku box | quality · volume · compact · full screen.
        -->
        <Grid x:Name="TransportCard" Style="{StaticResource LiveIslandTransportCardStyle}">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </Grid.OpacityTransition>
            <Grid.TranslationTransition>
                <Vector3Transition Duration="0:0:0.25" />
            </Grid.TranslationTransition>
            <Grid
                x:Name="TransportContent"
                Padding="12,8"
                RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Row 0 takes the place of the VOD progress row: one caption line, collapsed while empty.  -->
                <Grid
                    x:Name="FeedbackRow"
                    ColumnSpacing="12"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="SendFeedbackText"
                        AutomationProperties.LiveSetting="Assertive"
                        Style="{StaticResource LiveFeedbackTextStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="CommandFeedbackText"
                        Grid.Column="1"
                        MaxWidth="320"
                        AutomationProperties.LiveSetting="Assertive"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="Collapsed" />
                </Grid>

                <!--  Normal: Auto | * | Auto (island card). Full screen / compact: * | Auto | * (overlay bar, play centred).  -->
                <Grid
                    x:Name="CommandRow"
                    Grid.Row="1"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="CommandLeftColumn" Width="Auto" />
                        <ColumnDefinition x:Name="CommandMiddleColumn" Width="*" />
                        <ColumnDefinition x:Name="CommandRightColumn" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Core playback: play/pause, then back to the live edge (VOD: play + next / step).  -->
                    <StackPanel
                        x:Name="PlaybackGroup"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="PlayPauseButton"
                            Click="OnPlayPauseClick"
                            Style="{StaticResource LiveIslandPlayButtonStyle}">
                            <ic:SymbolIcon
                                x:Name="PlayPauseIcon"
                                FontSize="14"
                                IconVariant="Filled"
                                Symbol="Play" />
                        </Button>
                        <Button
                            x:Name="RefreshButton"
                            VerticalAlignment="Center"
                            Click="OnRefreshClick"
                            Style="{StaticResource CircleIconButtonStyle}">
                            <ic:SymbolIcon
                                x:Name="RefreshIcon"
                                FontSize="14"
                                Symbol="ArrowSync" />
                        </Button>
                    </StackPanel>

                    <!--  Danmaku box = IslandDanmakuBox: "弹" toggle + input (+ send, the live chat needs an explicit action).  -->
                    <Grid
                        x:Name="ComposerGroup"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton
                            x:Name="OverlayToggle"
                            Click="OnOverlayToggleClick"
                            Content="弹"
                            FontSize="12"
                            FontWeight="Black"
                            IsChecked="True"
                            Style="{StaticResource LiveIslandDanmakuToggleStyle}" />
                        <TextBox
                            x:Name="ComposerBox"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            AcceptsReturn="False"
                            IsSpellCheckEnabled="False"
                            KeyDown="OnComposerKeyDown"
                            MaxLength="100"
                            TextChanged="OnComposerTextChanged"
                            TextWrapping="NoWrap" />
                        <Button
                            x:Name="SendButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="OnSendClick"
                            IsEnabled="False"
                            Style="{StaticResource CircleIconButtonStyle}">
                            <ic:SymbolIcon FontSize="14" Symbol="Send" />
                        </Button>
                    </Grid>

                    <!--  Right stack, same order in every mode: quality, volume, compact overlay, full screen (rightmost).  -->
                    <StackPanel
                        x:Name="WindowGroup"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <!--  IslandFormatButton (quality).  -->
                        <Button
                            x:Name="QualityButton"
                            VerticalAlignment="Center"
                            Style="{StaticResource CircleIconButtonStyle}"
                            Visibility="Collapsed">
                            <ic:SymbolIcon FontSize="14" Symbol="Hd" />
                            <Button.Flyout>
                                <Flyout
                                    x:Name="QualityFlyout"
                                    Closed="OnTransportFlyoutClosed"
                                    FlyoutPresenterStyle="{StaticResource TransportButtonFlyoutPresenterStyle}"
                                    Opened="OnQualityFlyoutOpened"
                                    Placement="Top"
                                    ShouldConstrainToRootBounds="False">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            x:Name="QualityCaption"
                                            HorizontalAlignment="Left"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                        <ItemsView
                                            x:Name="QualityView"
                                            Width="220"
                                            IsItemInvokedEnabled="True"
                                            ItemInvoked="OnQualityItemInvoked"
                                            SelectionMode="Single">
                                            <ItemsView.ItemTemplate>
                                                <DataTemplate x:DataType="media:PlayerFormatInformation">
                                                    <ItemContainer Style="{StaticResource AppItemContainerStyle}">
                                                        <Grid
                                                            MinHeight="40"
                                                            Padding="12,0"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Description}" />
                                                        </Grid>
                                                    </ItemContainer>
                                                </DataTemplate>
                                            </ItemsView.ItemTemplate>
                                            <ItemsView.Layout>
                                                <StackLayout Spacing="4" />
                                            </ItemsView.Layout>
                                        </ItemsView>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button
                            x:Name="VolumeButton"
                            VerticalAlignment="Center"
                            Style="{StaticResource CircleIconButtonStyle}">
                            <ic:SymbolIcon
                                x:Name="VolumeIcon"
                                FontSize="14"
                                Symbol="Speaker2" />
                            <Button.Flyout>
                                <Flyout
                                    x:Name="VolumeFlyout"
                                    Closed="OnTransportFlyoutClosed"
                                    FlyoutPresenterStyle="{StaticResource TransportButtonFlyoutPresenterStyle}"
                                    Opened="OnTransportFlyoutOpened"
                                    Placement="Top"
                                    ShouldConstrainToRootBounds="False">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock
                                                x:Name="VolumeCaption"
                                                HorizontalAlignment="Left"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock
                                                x:Name="VolumeText"
                                                HorizontalAlignment="Right"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                        <Slider
                                            x:Name="VolumeSlider"
                                            Width="200"
                                            IsThumbToolTipEnabled="True"
                                            LargeChange="10"
                                            Maximum="100"
                                            Minimum="0"
                                            SmallChange="5"
                                            StepFrequency="1"
                                            TickFrequency="1"
                                            ValueChanged="OnVolumeChanged" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button
                            x:Name="CompactOverlayButton"
                            VerticalAlignment="Center"
                            Style="{StaticResource CircleIconButtonStyle}">
                            <ic:SymbolIcon
                                x:Name="CompactOverlayIcon"
                                FontSize="14"
                                Symbol="ContractUpRight" />
                        </Button>
                        <Button
                            x:Name="FullScreenButton"
                            VerticalAlignment="Center"
                            Style="{StaticResource CircleIconButtonStyle}">
                            <ic:SymbolIcon
                                x:Name="FullScreenIcon"
                                FontSize="14"
                                Symbol="FullScreenMaximize" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!--  ============ Side panel (VOD SideHeader + SideBody). Hiding it only collapses the view; chat stays connected. ============  -->
        <Grid
            x:Name="ChatPanel"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Padding="16,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="ChatHeaderText"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis" />
                <Ellipse
                    x:Name="ChatDot"
                    Grid.Column="1"
                    Width="8"
                    Height="8"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw" />
                <TextBlock
                    x:Name="ChatStatusText"
                    Grid.Column="2"
                    MaxWidth="160"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <Border
                Grid.Row="1"
                Height="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Grid Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <ListView
                    x:Name="MessageList"
                    Padding="0,4"
                    IsItemClickEnabled="False"
                    ItemContainerStyle="{StaticResource LiveMessageItemStyle}"
                    SelectionMode="None">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel VerticalAlignment="Bottom" ItemsUpdatingScrollMode="KeepLastItemInView" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <!--  One row = name (secondary) + body (primary).  -->
                        <DataTemplate x:DataType="live:LiveChatMessage">
                            <TextBlock
                                IsTextSelectionEnabled="False"
                                Style="{StaticResource BodyTextBlockStyle}"
                                TextWrapping="Wrap">
                                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind UserName}" />
                                <Run Text=" " />
                                <Run Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind Text}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="EmptyText"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsHitTestVisible="False"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <Button
                    x:Name="JumpButton"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Click="OnJumpClick"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Symbol="ArrowDown" />
                        <TextBlock x:Name="JumpText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
