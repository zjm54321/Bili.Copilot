<?xml version="1.0" encoding="utf-8" ?>
<core:PlayerControlBase
    x:Class="BiliCopilot.UI.Controls.Player.StoreIsland.IslandNextVideoButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:BiliCopilot.UI.Controls.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  Store 源 Controls/Player/VideoPlayerTransportLeftPanel.xaml：左槽仅“下一个视频”入口，Margin -6,0,0,0 原样保留  -->
    <Grid Margin="-6,0,0,0">
        <Button
            VerticalAlignment="Center"
            Command="{x:Bind ViewModel.PlayNextCommand, Mode=OneWay}"
            Style="{StaticResource CircleIconButtonStyle}"
            ToolTipService.ToolTip="{x:Bind ViewModel.NextButtonToolTip, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsNextButtonEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ic:SymbolIcon
                FontSize="14"
                IconVariant="Filled"
                Symbol="Next" />
        </Button>
    </Grid>
</core:PlayerControlBase>
