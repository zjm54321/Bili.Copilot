<?xml version="1.0" encoding="utf-8" ?>
<local:SystemMessageControlBase
    x:Class="BiliCopilot.UI.Controls.Message.SystemMessageSideItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Message"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ic:SymbolIcon
            VerticalAlignment="Center"
            FontSize="14"
            Symbol="Megaphone" />
        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            Text="{ext:Locale Name=SystemNotification}" />
        <InfoBadge
            Grid.Column="2"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.UnreadCount, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}"
            Value="{x:Bind ViewModel.UnreadCount, Mode=OneWay}" />
    </Grid>
</local:SystemMessageControlBase>
