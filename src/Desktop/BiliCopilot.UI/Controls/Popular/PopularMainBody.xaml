<?xml version="1.0" encoding="utf-8" ?>
<local:PopularPageControlBase
    x:Class="BiliCopilot.UI.Controls.Popular.PopularMainBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Popular"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:repeater="using:Richasy.WinUIKernel.Share.Base.Repeater"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="RecommendStyle" x:DataType="items:VideoItemViewModel">
            <components:VideoCardControl Style="{StaticResource RecommendVideoCardStyle}" ViewModel="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="HotStyle" x:DataType="items:VideoItemViewModel">
            <components:VideoCardControl Style="{StaticResource HotVideoCardStyle}" ViewModel="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="RankStyle" x:DataType="items:VideoItemViewModel">
            <components:VideoCardControl Style="{StaticResource RankVideoCardStyle}" ViewModel="{x:Bind}" />
        </DataTemplate>
        <ext:VideoCardTemplateSelector
            x:Key="CardSelector"
            HotTemplate="{StaticResource HotStyle}"
            RankTemplate="{StaticResource RankStyle}"
            RecommendTemplate="{StaticResource RecommendStyle}" />
    </UserControl.Resources>

    <Grid>
        <controls:IncrementVerticalScrollControl x:Name="View" ScrollPadding="16,0" LoadMoreCommand="{x:Bind ViewModel.LoadVideosCommand}" RefreshCommand="{x:Bind ViewModel.RefreshVideoCommand, Mode=OneWay}">
            <controls:IncrementVerticalScrollControl.Element>
                <Grid Margin="0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <repeater:AppRepeater
                        x:Name="VideoRepeater"
                        ItemsSource="{x:Bind CategorySource.VisibleItems, Mode=OneTime}"
                        Layout="{StaticResource VideoLayout}">
                        <repeater:AppRepeater.ItemTemplate>
                            <DataTemplate x:DataType="items:VideoItemViewModel">
                                <ContentControl
                                    Content="{x:Bind}"
                                    controls:VideoCategorySource.ItemRow="{x:Bind}"
                                    ContentTemplateSelector="{StaticResource CardSelector}"
                                    Style="{StaticResource AppContentControlStyle}" />
                            </DataTemplate>
                        </repeater:AppRepeater.ItemTemplate>
                    </repeater:AppRepeater>
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        Spacing="12">
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind local:PopularMainBody.PagedAppendErrorVisibility(ViewModel.SelectedSection, ViewModel.HasAppendError, ViewModel.IsAppending), Mode=OneWay}">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{ext:Locale Name=LoadMoreFailed}" />
                            <HyperlinkButton
                                Padding="4,2"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.RetryAppendCommand, Mode=OneWay}"
                                Content="{ext:Locale Name=Retry}" />
                        </StackPanel>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{ext:Locale Name=NoMoreContent}"
                            Visibility="{x:Bind local:PopularMainBody.PagedExhaustedVisibility(ViewModel.SelectedSection, ViewModel.IsPrefetchExhausted, ViewModel.HasAppendError, ViewModel.IsAppending, ViewModel.Videos.Count), Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </controls:IncrementVerticalScrollControl.Element>
        </controls:IncrementVerticalScrollControl>
        <base:LoadingWidget Text="{ext:Locale Name=LoadingAndWait}" Visibility="{x:Bind ViewModel.IsVideoLoading, Mode=OneWay}" />
    </Grid>
</local:PopularPageControlBase>
