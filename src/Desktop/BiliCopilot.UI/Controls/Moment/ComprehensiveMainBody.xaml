<?xml version="1.0" encoding="utf-8" ?>
<local:MomentUperSectionControlBase
    x:Class="BiliCopilot.UI.Controls.Moment.ComprehensiveMainBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Moment"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:repeater="using:Richasy.WinUIKernel.Share.Base.Repeater"
    mc:Ignorable="d">

    <Grid>
        <controls:IncrementVerticalScrollControl x:Name="View" LoadMoreCommand="{x:Bind ViewModel.LoadItemsCommand, Mode=OneWay}" RefreshCommand="{x:Bind ViewModel.RefreshFeedCommand, Mode=OneWay}">
            <controls:IncrementVerticalScrollControl.Element>
                <Grid Margin="0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <repeater:AppRepeater MaxWidth="1200" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                        <repeater:AppRepeater.ItemTemplate>
                            <DataTemplate x:DataType="items:MomentItemViewModel">
                                <components:MomentCardControl
                                    Margin="0,6"
                                    Style="{StaticResource FullMomentCardStyle}"
                                    ViewModel="{x:Bind}" />
                            </DataTemplate>
                        </repeater:AppRepeater.ItemTemplate>
                    </repeater:AppRepeater>
                    <!--  追加页脚：失败时可显式重试；到底时安静提示  -->
                    <Grid Grid.Row="1" HorizontalAlignment="Center">
                        <StackPanel
                            Margin="0,12,0,0"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind controls:IncrementVerticalScrollControl.AppendErrorFooterVisibility(ViewModel.HasAppendError, ViewModel.IsAppending), Mode=OneWay}">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{ext:Locale Name=LoadMoreFailed}" />
                            <HyperlinkButton
                                Padding="4,2"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.RetryAppendCommand, Mode=OneWay}"
                                Content="{ext:Locale Name=Retry}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,12,0,0"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{ext:Locale Name=NoMoreContent}"
                            Visibility="{x:Bind controls:IncrementVerticalScrollControl.ExhaustedFooterVisibility(ViewModel.IsPrefetchExhausted, ViewModel.HasAppendError, ViewModel.IsAppending, ViewModel.Items.Count), Mode=OneWay}" />
                    </Grid>
                </Grid>
            </controls:IncrementVerticalScrollControl.Element>
        </controls:IncrementVerticalScrollControl>
        <base:EmptyHolder
            Description="{ext:Locale Name=NoSpecificData}"
            Emoji="&#x1F440;"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <base:LoadingWidget Text="{ext:Locale Name=LoadingAndWait}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </Grid>
</local:MomentUperSectionControlBase>
