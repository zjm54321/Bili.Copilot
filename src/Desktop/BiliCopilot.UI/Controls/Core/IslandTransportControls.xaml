<?xml version="1.0" encoding="utf-8" ?>
<local:PlayerControlBase
    x:Class="BiliCopilot.UI.Controls.Core.IslandTransportControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:BiliCopilot.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <local:PlayerControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush
                        x:Key="TransportBackground"
                        Opacity="0.78"
                        Color="White" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush
                        x:Key="TransportBackground"
                        Opacity="0.67"
                        Color="Black" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="TransportBackground" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <converters:CompactOverlayConverter x:Key="CompactOverlayConverter" />
            <converters:FullScreenConverter x:Key="FullScreenConverter" />

            <Style
                x:Key="TransportButtonFlyoutPresenterStyle"
                BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                TargetType="FlyoutPresenter">
                <Setter Property="Padding" Value="12,10" />
            </Style>
        </ResourceDictionary>
    </local:PlayerControlBase.Resources>

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Bottom"
        Margin="12"
        MaxWidth="800"
        GotFocus="OnControlGotFocus"
        LostFocus="OnControlLostFocus"
        Background="{ThemeResource TransportBackground}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource OverlayCornerRadius}">
        <Grid Padding="12,8" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="ProgressText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                <Slider
                    x:Name="ProgressSlider"
                    Grid.Column="1"
                    MinHeight="0"
                    HorizontalAlignment="Stretch"
                    IsThumbToolTipEnabled="False"
                    Maximum="{x:Bind ViewModel.Player.Duration, Mode=OneWay}"
                    ValueChanged="OnProgressSliderValueChanged" />
                <TextBlock
                    x:Name="DurationText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <ProgressRing
                        Width="38"
                        Height="38"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind local:IslandTransportControls.IsBuffering(ViewModel.Player.PlaybackState, ViewModel.Player.IsLoading), Mode=OneWay}"
                        Visibility="{x:Bind local:IslandTransportControls.GetBufferingVisibility(ViewModel.Player.PlaybackState, ViewModel.Player.IsLoading), Mode=OneWay}" />
                    <Button
                        x:Name="PlayPauseButton"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ButtonBackground}"
                        Command="{x:Bind ViewModel.PlayPauseCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind local:IslandTransportControls.IsNotBuffering(ViewModel.Player.PlaybackState, ViewModel.Player.IsLoading), Mode=OneWay}"
                        Style="{StaticResource CircleIconButtonStyle}">
                        <Grid>
                            <ic:SymbolIcon
                                FontSize="14"
                                IconVariant="Filled"
                                Symbol="Play"
                                Visibility="{x:Bind local:IslandTransportControls.GetPlayVisibility(ViewModel.Player.PlaybackState), Mode=OneWay}" />
                            <ic:SymbolIcon
                                FontSize="14"
                                IconVariant="Filled"
                                Symbol="Pause"
                                Visibility="{x:Bind local:IslandTransportControls.GetPauseVisibility(ViewModel.Player.PlaybackState), Mode=OneWay}" />
                        </Grid>
                    </Button>
                </Grid>

                <ContentControl
                    x:Name="LeftPanel"
                    Grid.Column="1"
                    Content="{x:Bind LeftContent, Mode=OneWay}"
                    Style="{StaticResource AppContentControlStyle}" />
                <ContentControl
                    x:Name="MiddlePanel"
                    Grid.Column="2"
                    Content="{x:Bind MiddleContent, Mode=OneWay}"
                    Style="{StaticResource AppContentControlStyle}" />
                <ContentControl
                    x:Name="RightPanel"
                    Grid.Column="3"
                    Content="{x:Bind RightContent, Mode=OneWay}"
                    Style="{StaticResource AppContentControlStyle}" />
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <!--  音量  -->
                    <Button
                        Margin="0,0,8,0"
                        Style="{StaticResource CircleIconButtonStyle}"
                        ToolTipService.ToolTip="{ext:Locale Name=CurrentVolume}">
                        <ic:SymbolIcon FontSize="14" Symbol="Speaker2" />
                        <Button.Flyout>
                            <Flyout
                                x:Name="VolumeFlyout"
                                FlyoutPresenterStyle="{StaticResource TransportButtonFlyoutPresenterStyle}"
                                Opening="OnTransportFlyoutOpening"
                                Opened="OnTransportFlyoutOpened"
                                Placement="Top"
                                ShouldConstrainToRootBounds="False">
                                <StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{ext:Locale Name=CurrentVolume}" />
                                    <Slider
                                        x:Name="VolumeSlider"
                                        Width="200"
                                        IsThumbToolTipEnabled="True"
                                        Maximum="100"
                                        Minimum="0"
                                        StepFrequency="1"
                                        TickFrequency="1"
                                        ValueChanged="OnVolumeSliderValueChanged"
                                        Value="{x:Bind ViewModel.Player.Volume, Mode=OneWay}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!--  倍速  -->
                    <Button
                        Margin="0,0,8,0"
                        Style="{StaticResource CircleIconButtonStyle}"
                        ToolTipService.ToolTip="{ext:Locale Name=PlaybackRate}">
                        <TextBlock FontSize="14">
                            <Run Text="{x:Bind ViewModel.Player.PlaybackRate, Mode=OneWay}" /><Run Text="x" />
                        </TextBlock>
                        <Button.Flyout>
                            <!--  与全屏 OverlayTransportControls 倍速浮出内容同一模板：快捷倍速 + 0.1~3x 细调滑块  -->
                            <Flyout
                                x:Name="SpeedFlyout"
                                Opening="OnTransportFlyoutOpening"
                                Opened="OnTransportFlyoutOpened"
                                Placement="Top"
                                ShouldConstrainToRootBounds="False">
                                <StackPanel Spacing="12">
                                    <Grid
                                        MinHeight="28"
                                        Padding="4,0,4,4"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton
                                            x:Name="HalfSpeedButton"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnQuickSpeedButtonClick"
                                            Content="0.5x"
                                            Tag="0.5" />
                                        <ToggleButton
                                            x:Name="DefaultSpeedButton"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnQuickSpeedButtonClick"
                                            Content="1.0x"
                                            Tag="1.0" />
                                        <ToggleButton
                                            x:Name="OneTwoFiveSpeedButton"
                                            Grid.Column="2"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnQuickSpeedButtonClick"
                                            Content="1.25x"
                                            Tag="1.25" />
                                        <ToggleButton
                                            x:Name="OneHalfSpeedButton"
                                            Grid.Column="3"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnQuickSpeedButtonClick"
                                            Content="1.5x"
                                            Tag="1.5" />
                                        <ToggleButton
                                            x:Name="DoubleSpeedButton"
                                            Grid.Column="4"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnQuickSpeedButtonClick"
                                            Content="2.0x"
                                            Tag="2.0" />
                                        <ToggleButton
                                            x:Name="TripleSpeedButton"
                                            Grid.Column="5"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnQuickSpeedButtonClick"
                                            Content="3.0x"
                                            Tag="3.0" />
                                    </Grid>
                                    <Slider
                                        x:Name="SpeedSlider"
                                        Width="350"
                                        Margin="0,0,0,-6"
                                        VerticalAlignment="Center"
                                        LargeChange="0.5"
                                        Maximum="3"
                                        Minimum="0.1"
                                        SmallChange="0.05"
                                        StepFrequency="0.05"
                                        ValueChanged="OnSpeedSliderValueChanged"
                                        Value="{x:Bind ViewModel.Player.PlaybackRate, Mode=OneWay}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!--  小窗  -->
                    <Button
                        Margin="0,0,8,0"
                        Command="{x:Bind ViewModel.ToggleCompactOverlayCommand, Mode=OneWay}"
                        Style="{StaticResource CircleIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Player.IsCompactOverlay, Mode=OneWay, Converter={StaticResource CompactOverlayConverter}}">
                        <ic:SymbolIcon FontSize="14" Symbol="{x:Bind ViewModel.Player.IsCompactOverlay, Mode=OneWay, Converter={StaticResource CompactOverlayConverter}}" />
                    </Button>

                    <!--  全屏  -->
                    <Button
                        Command="{x:Bind ViewModel.ToggleFullScreenCommand, Mode=OneWay}"
                        Style="{StaticResource CircleIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Player.IsFullScreen, Mode=OneWay, Converter={StaticResource FullScreenConverter}}">
                        <ic:SymbolIcon FontSize="14" Symbol="{x:Bind ViewModel.Player.IsFullScreen, Mode=OneWay, Converter={StaticResource FullScreenConverter}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</local:PlayerControlBase>
